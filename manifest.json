{
  "manifest_version": 3,
  "name": "SocialBudi Cookie Extractor",
  "version": "1.0.0",
  "description": "Extract LinkedIn cookies easily for SocialBudi scraping services",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://contentscrapingserver.site/*",
        "*://localhost:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
